generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model AdminUser { id String @id @default(uuid()) @db.Uuid email String @unique passwordHash String role String @default("VIEWER") createdAt DateTime @default(now()) @db.Timestamptz(6) updatedAt DateTime @updatedAt @db.Timestamptz(6) sessions AdminSession[] }
model AdminSession { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid tokenHash String @unique expiresAt DateTime @db.Timestamptz(6) createdAt DateTime @default(now()) @db.Timestamptz(6) user AdminUser @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model Service { id String @id @default(uuid()) @db.Uuid name String @unique description String? createdAt DateTime @default(now()) @db.Timestamptz(6) routes Route[] targets UpstreamTarget[] }
model Route { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid name String path String match String @default("prefix") methods Json hosts Json @default("[]") rewrite String? enabled Boolean @default(true) priority Int @default(0) timeoutMs Int @default(10000) maxBodyBytes Int @default(10485760) apiKeyRequired Boolean @default(false) limit Int? windowSeconds Int @default(60) createdAt DateTime @default(now()) @db.Timestamptz(6) service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([enabled,priority,path]) }
model UpstreamTarget { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid url String weight Int @default(1) enabled Boolean @default(true) createdAt DateTime @default(now()) @db.Timestamptz(6) service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([serviceId,enabled]) }
model Consumer { id String @id @default(uuid()) @db.Uuid name String @unique createdAt DateTime @default(now()) @db.Timestamptz(6) apiKeys ApiKey[] }
model ApiKey { id String @id @default(uuid()) @db.Uuid consumerId String @db.Uuid digest String @unique prefix String expiresAt DateTime? revokedAt DateTime? createdAt DateTime @default(now()) @db.Timestamptz(6) consumer Consumer @relation(fields:[consumerId],references:[id],onDelete:Cascade) @@index([consumerId,revokedAt]) }
model JwtPolicy { id String @id @default(uuid()) @db.Uuid routeId String issuer String audience String jwksUrl String algorithms Json @default("[\"RS256\"]") createdAt DateTime @default(now()) @db.Timestamptz(6) }
model RateLimitPolicy { id String @id @default(uuid()) @db.Uuid routeId String limit Int windowSeconds Int scope String @default("IP") failClosed Boolean @default(true) }
model CircuitBreakerPolicy { id String @id @default(uuid()) @db.Uuid serviceId String @db.Uuid failureThreshold Int @default(5) recoveryMs Int @default(30000) probes Int @default(1) }
model CachePolicy { id String @id @default(uuid()) @db.Uuid routeId String ttlSeconds Int enabled Boolean @default(false) }
model GatewayConfigVersion { id String @id @default(uuid()) @db.Uuid version Int @unique config Json createdAt DateTime @default(now()) @db.Timestamptz(6) }
model AuditLog { id String @id @default(uuid()) @db.Uuid actorId String? @db.Uuid action String resource String resourceId String? metadata Json @default("{}") createdAt DateTime @default(now()) @db.Timestamptz(6) @@index([createdAt]) @@index([resource,resourceId]) }
