{
  "name": "gatekeeper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:gateway": "pnpm --filter @gatekeeper/gateway dev",
    "dev:control": "pnpm --filter @gatekeeper/control-plane dev",
    "dev:dashboard": "pnpm --filter @gatekeeper/dashboard dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "devDependencies": { "prisma": "^6.5.0", "typescript": "^5.8.2", "vitest": "^3.0.8" }
}
